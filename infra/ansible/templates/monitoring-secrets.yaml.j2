# Rendered by infra/ansible from ~/.miniarcade and piped to kubectl; never
# written to disk or Git. kube-prometheus-stack reads both Secrets by name.
apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
stringData:
  admin-user: admin
  admin-password: {{ grafana_admin_password | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-miniarcade
  namespace: monitoring
type: Opaque
stringData:
  alertmanager.yaml: {{ lookup('ansible.builtin.template', 'alertmanager.yaml.j2') | to_json }}
