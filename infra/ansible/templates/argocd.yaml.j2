# Written by infra/ansible. k3s's Helm controller installs the pinned chart.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: "{{ argocd_chart_version }}"
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    dex:
      enabled: false
    notifications:
      enabled: false
    configs:
      params:
        # Reached only through kubectl port-forward, which is already an
        # encrypted tunnel, so the UI serves plain HTTP.
        server.insecure: true
